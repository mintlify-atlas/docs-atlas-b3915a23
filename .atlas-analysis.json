  "keyFeatures": [
    "Serverless Postgres with instant provisioning",
    "Database branching: copy-on-write clones for dev/test workflows",
    "Autoscaling: compute scales up and down automatically based on load",
    "Scale to zero: compute suspends during inactivity to save costs",
    "Read replicas for horizontal read scalability",
    "Point-in-time restore and branch restore",
    "Neon Auth: built-in managed authentication that branches with your database",
    "Data API: REST/GraphQL access to Postgres over HTTP",
    "Neon MCP server for AI coding agents",
    "pgvector support for AI/ML embeddings and vector search",
    "Broad extension support (PostGIS, pgcron, pg_search, etc.)",
    "CLI and Terraform provider for infrastructure-as-code workflows"
  ],
  "publicApiSurface": [
    "Neon Management API (REST): /projects, /branches, /databases, /roles, /operations",
    "Data API: HTTP-based Postgres query interface at /api/query",
    "@neondatabase/neon-js TypeScript SDK: createClient(), createAuthClient()",
    "@neondatabase/serverless: WebSocket/HTTP Postgres driver for edge environments",
    "Neon CLI: neonctl projects, branches, databases, roles, connection-string",
    "Neon MCP Server: AI agent tool integration for Postgres management",
    "Terraform provider: neondatabase/neon resources for IaC",
    "Python SDK: neon_api Python client",
    "GitHub Actions: neondatabase/create-branch-action, delete-branch-action"
  ]
